{
  "manifest_version": 3,
  "name": "学习通答题助手",
  "version": "1.1.0",
  "description": "抓取学习通题目，调用你配置的 OpenAI 兼容模型 API 生成答案，确认后填充（仅供自查与练习）。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.chaoxing.com/*",
    "*://*.xuexi365.com/*",
    "*://*.edu.cn/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.chaoxing.com/*",
        "*://*.xuexi365.com/*",
        "*://*.edu.cn/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "学习通答题助手"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
